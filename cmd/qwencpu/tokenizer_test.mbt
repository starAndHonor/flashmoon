///| Oracle: refs/qwen3-0.6b/tokenizer_cases.json generated by HF `tokenizers`

///|
/// (see gen_ref.py workflow).
fn refs_dir() -> String {
  // moon test runs at the package dir; be robust to repo-root cwd too
  if @fs.path_exists("../../refs/qwen3-0.6b/tokenizer_cases.json") {
    "../../refs/qwen3-0.6b"
  } else {
    "refs/qwen3-0.6b"
  }
}

///|
test "tokenizer encodes HF oracle cases exactly" {
  let tok = @qwen3.Tokenizer::load(
    @fs.read_file_to_string(refs_dir() + "/tokenizer.json"),
  )
  let cases : Json = @json.parse(
    @fs.read_file_to_string(refs_dir() + "/tokenizer_cases.json"),
  )
  guard cases is Array(cases) else { fail("cases not array") }
  for cj in cases {
    guard cj is Object(c) else { fail("bad case") }
    guard c["text"] is String(text) else { fail("no text") }
    guard c["ids"] is Array(idsj) else { fail("no ids") }
    let want : Array[Int] = []
    for ij in idsj {
      guard ij is Number(i, ..) else { fail("bad id") }
      want.push(i.to_int())
    }
    let got = tok.encode(text)
    if got != want {
      fail("encode mismatch for \{text.escape()}: got \{got} want \{want}")
    }
    // decode round-trip (text is plain UTF-8, no specials)
    let back = tok.decode(want)
    assert_eq(back, text)
  }
}
